{
  "title": "montecrit manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "manifest"
    },
    "pack": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "string",
      "const": "2024"
    },
    "namespace": {
      "type": "string",
      "enum": [
        "srd",
        "private",
        "test"
      ]
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "private",
        "test"
      ]
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "kind",
    "pack",
    "version",
    "rules",
    "namespace",
    "license"
  ],
  "additionalProperties": false
}
