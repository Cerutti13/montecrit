{
  "title": "montecrit armor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "armor"
    },
    "id": {
      "type": "string",
      "pattern": "^(core|srd|private|test):[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "fidelity": {
      "default": "full",
      "type": "string",
      "enum": [
        "full",
        "partial",
        "narrative"
      ]
    },
    "placeholder": {
      "default": false,
      "type": "boolean"
    },
    "unimplemented": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "foundry-dnd5e"
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "foreignId": {
              "type": "string",
              "minLength": 1
            },
            "recordSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "importer": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "file",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "pdfPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "crossCheck": {
              "type": "object",
              "properties": {
                "open5e": {
                  "type": "string",
                  "enum": [
                    "agree",
                    "disagree",
                    "missing"
                  ]
                }
              },
              "required": [
                "open5e"
              ],
              "additionalProperties": false
            },
            "review": {
              "type": "string",
              "enum": [
                "auto",
                "reviewed"
              ]
            }
          },
          "required": [
            "source",
            "ref",
            "path",
            "foreignId",
            "recordSha256",
            "importer",
            "review"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "srd-pdf"
            },
            "pdfPage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "importer": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "overrides": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "file",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "replaces": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "foreignId": {
                  "type": "string",
                  "minLength": 1
                },
                "recordSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "ref",
                "path",
                "foreignId",
                "recordSha256"
              ],
              "additionalProperties": false
            },
            "review": {
              "type": "string",
              "enum": [
                "hand",
                "reviewed"
              ]
            }
          },
          "required": [
            "source",
            "pdfPage",
            "importer",
            "overrides",
            "review"
          ],
          "additionalProperties": false
        }
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "light",
        "medium",
        "heavy",
        "shield"
      ]
    },
    "ac": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "dexCap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "stealthDis": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "source",
    "category",
    "ac"
  ],
  "additionalProperties": false
}
